{
  "$id": "urn:ai02:1.0.0:invoice-values",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "All keys required; null explicitly represents a missing value.",
  "properties": {
    "currency": {
      "anyOf": [
        {
          "const": "VND",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Currency"
    },
    "invoice_date": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invoice Date"
    },
    "invoice_number": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invoice Number"
    },
    "seller_name": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Seller Name"
    },
    "total_amount": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Total Amount"
    }
  },
  "required": [
    "invoice_number",
    "invoice_date",
    "seller_name",
    "total_amount",
    "currency"
  ],
  "title": "InvoiceValues",
  "type": "object"
}
