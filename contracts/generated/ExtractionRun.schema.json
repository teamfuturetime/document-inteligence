{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "mapping_signals": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Mapping Signals",
          "type": "object"
        },
        "method": {
          "default": "unknown",
          "enum": [
            "unknown",
            "simulated",
            "heuristic",
            "calibrated"
          ],
          "title": "Method",
          "type": "string"
        },
        "ocr_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Score"
        },
        "policy_version": {
          "default": "confidence-draft-1",
          "title": "Policy Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "Confidence",
      "type": "object"
    },
    "FieldPrediction": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "field_id": {
          "enum": [
            "full_name",
            "student_id",
            "date_of_birth",
            "class_name",
            "faculty",
            "request_content",
            "request_date"
          ],
          "title": "Field Id",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Value"
        },
        "observation": {
          "enum": [
            "found",
            "not_found",
            "unreadable",
            "unknown"
          ],
          "title": "Observation",
          "type": "string"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Value"
        }
      },
      "required": [
        "field_id",
        "raw_value",
        "normalized_value",
        "observation",
        "evidence_status"
      ],
      "title": "FieldPrediction",
      "type": "object"
    },
    "OCRSpan": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "original_pixels_top_left",
          "default": "original_pixels_top_left",
          "title": "Coordinate System",
          "type": "string"
        },
        "image_height": {
          "exclusiveMinimum": 0,
          "title": "Image Height",
          "type": "integer"
        },
        "image_width": {
          "exclusiveMinimum": 0,
          "title": "Image Width",
          "type": "integer"
        },
        "ocr_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Score"
        },
        "page_index": {
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "span_id": {
          "title": "Span Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "transform": {
          "const": "identity",
          "default": "identity",
          "title": "Transform",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "page_index",
        "text",
        "image_width",
        "image_height"
      ],
      "title": "OCRSpan",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "enum": [
            "synthetic",
            "sample"
          ],
          "title": "Data Origin",
          "type": "string"
        },
        "prediction_source": {
          "enum": [
            "fixture",
            "model",
            "unavailable"
          ],
          "title": "Prediction Source",
          "type": "string"
        }
      },
      "required": [
        "data_origin",
        "prediction_source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldPrediction"
      },
      "title": "Fields",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/OCRSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "document_id",
    "schema_version",
    "provenance",
    "fields",
    "spans",
    "status"
  ],
  "title": "ExtractionRun",
  "type": "object"
}
