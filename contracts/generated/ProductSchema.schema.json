        "field_id": {
          "enum": [
            "invoice_number",
            "invoice_date",
            "seller_name",
            "total_amount",
            "currency",
            "full_name",
            "student_id",
            "date_of_birth",
            "class_name",
            "faculty",
            "request_content",
            "request_date"
          ],
          "title": "Field Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "required": {
