{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "edit",
        "clear",
        "confirm"
      ],
      "title": "Action",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "field_id": {
      "anyOf": [
        {
          "enum": [
            "full_name",
            "student_id",
            "date_of_birth",
            "class_name",
            "faculty",
            "request_content",
            "request_date"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Field Id"
    },
    "new_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "New Value"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "old_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Old Value"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Id"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "run_id",
    "revision",
    "field_id",
    "action",
    "old_value",
    "new_value",
    "occurred_at"
  ],
  "title": "ReviewEvent",
  "type": "object"
}
