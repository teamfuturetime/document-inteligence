{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "mapping_signals": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Mapping Signals",
          "type": "object"
        },
        "method": {
          "default": "unknown",
          "enum": [
            "unknown",
            "simulated",
            "heuristic",
            "calibrated"
          ],
          "title": "Method",
          "type": "string"
        },
        "ocr_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Score"
        },
        "policy_version": {
          "default": "confidence-draft-1",
          "title": "Policy Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "Confidence",
      "type": "object"
    },
    "FieldDefinition": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "enum": [
            "invoice_number",
            "invoice_date",
            "seller_name",
            "total_amount",
            "currency",
            "full_name",
            "student_id",
            "date_of_birth",
            "class_name",
            "faculty",
            "request_content",
            "request_date"
          ],
          "title": "Field Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "value_type": {
          "enum": [
            "text",
            "date",
            "integer",
            "currency"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "label",
        "value_type"
      ],
      "title": "FieldDefinition",
      "type": "object"
    },
    "ProductIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field_path": {
          "enum": [
            "invoice_number",
            "invoice_date",
            "seller_name",
            "total_amount",
            "currency",
            "full_name",
            "student_id",
            "date_of_birth",
            "class_name",
            "faculty",
            "request_content",
            "request_date"
          ],
          "title": "Field Path",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "code",
        "message"
      ],
      "title": "ProductIssue",
      "type": "object"
    },
    "ProductPrediction": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "field_id": {
          "enum": [
            "invoice_number",
            "invoice_date",
            "seller_name",
            "total_amount",
            "currency",
            "full_name",
            "student_id",
            "date_of_birth",
            "class_name",
            "faculty",
            "request_content",
            "request_date"
          ],
          "title": "Field Id",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Value"
        },
        "observation": {
          "enum": [
            "found",
            "not_found",
            "unknown"
          ],
          "title": "Observation",
          "type": "string"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Value"
        }
      },
      "required": [
        "field_id",
        "raw_value",
        "normalized_value",
        "observation",
        "evidence_span_ids",
        "confidence"
      ],
      "title": "ProductPrediction",
      "type": "object"
    },
    "ProductReviewedField": {
      "additionalProperties": false,
      "properties": {
        "is_reviewed": {
          "title": "Is Reviewed",
          "type": "boolean"
        },
        "reviewed_value": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed Value"
        }
      },
      "required": [
        "is_reviewed",
        "reviewed_value"
      ],
      "title": "ProductReviewedField",
      "type": "object"
    },
    "ProductRevision": {
      "additionalProperties": false,
      "properties": {
        "effective_data": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 16000,
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "invoice_number",
              "invoice_date",
              "seller_name",
              "total_amount",
              "currency",
              "full_name",
              "student_id",
              "date_of_birth",
              "class_name",
              "faculty",
              "request_content",
              "request_date"
            ]
          },
          "title": "Effective Data",
          "type": "object"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/ProductReviewedField"
          },
          "propertyNames": {
            "enum": [
              "invoice_number",
              "invoice_date",
              "seller_name",
              "total_amount",
              "currency",
              "full_name",
              "student_id",
              "date_of_birth",
              "class_name",
              "faculty",
              "request_content",
              "request_date"
            ]
          },
          "title": "Fields",
          "type": "object"
        },
        "review_status": {
          "enum": [
            "draft",
            "confirmed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "saved_at": {
          "format": "date-time",
          "title": "Saved At",
          "type": "string"
        },
        "validation_issues": {
          "items": {
            "$ref": "#/$defs/ProductIssue"
          },
          "title": "Validation Issues",
          "type": "array"
        }
      },
      "required": [
        "revision",
        "review_status",
        "fields",
        "effective_data",
        "validation_issues",
        "saved_at"
      ],
      "title": "ProductRevision",
      "type": "object"
    },
    "ProductRun": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ProductPrediction"
          },
          "title": "Fields",
          "type": "array"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/ProductSpan"
          },
          "title": "Spans",
          "type": "array"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "status",
        "created_at"
      ],
      "title": "ProductRun",
      "type": "object"
    },
    "ProductSpan": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "ocr_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ocr Score"
        },
        "page_index": {
          "const": 0,
          "default": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "span_id": {
          "title": "Span Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "text",
        "box",
        "ocr_score"
      ],
      "title": "ProductSpan",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_origin": {
      "enum": [
        "synthetic",
        "sample"
      ],
      "title": "Data Origin",
      "type": "string"
    },
    "definitions": {
      "items": {
        "$ref": "#/$defs/FieldDefinition"
      },
      "title": "Definitions",
      "type": "array"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "document_type": {
      "enum": [
        "hoa_don",
        "don_de_nghi"
      ],
      "title": "Document Type",
      "type": "string"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "image_height": {
      "title": "Image Height",
      "type": "integer"
    },
    "image_url": {
      "title": "Image Url",
      "type": "string"
    },
    "image_width": {
      "title": "Image Width",
      "type": "integer"
    },
    "input_sha256": {
      "title": "Input Sha256",
      "type": "string"
    },
    "is_latest_run": {
      "title": "Is Latest Run",
      "type": "boolean"
    },
    "latest_run_id": {
      "title": "Latest Run Id",
      "type": "string"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductRevision"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Status"
    },
    "run": {
      "$ref": "#/$defs/ProductRun"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "document_type",
    "filename",
    "data_origin",
    "input_sha256",
    "image_width",
    "image_height",
    "created_at",
    "latest_run_id",
    "status",
    "image_url",
    "definitions",
    "run",
    "review",
    "is_latest_run"
  ],
  "title": "DocumentDetail",
  "type": "object"
}
