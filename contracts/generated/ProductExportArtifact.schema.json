{
  "$defs": {
    "FinalApplicationData": {
      "additionalProperties": false,
      "properties": {
        "class_name": {
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "date_of_birth": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date Of Birth",
          "type": "string"
        },
        "faculty": {
          "minLength": 1,
          "title": "Faculty",
          "type": "string"
        },
        "full_name": {
          "minLength": 1,
          "title": "Full Name",
          "type": "string"
        },
        "request_content": {
          "minLength": 1,
          "title": "Request Content",
          "type": "string"
        },
        "request_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Request Date",
          "type": "string"
        },
        "student_id": {
          "pattern": "^[0-9]+$",
          "title": "Student Id",
          "type": "string"
        }
      },
      "required": [
        "full_name",
        "student_id",
        "date_of_birth",
        "class_name",
        "faculty",
        "request_content",
        "request_date"
      ],
      "title": "FinalApplicationData",
      "type": "object"
    },
    "FinalInvoiceData": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "VND",
          "title": "Currency",
          "type": "string"
        },
        "invoice_date": {
          "title": "Invoice Date",
          "type": "string"
        },
        "invoice_number": {
          "minLength": 1,
          "title": "Invoice Number",
          "type": "string"
        },
        "seller_name": {
          "minLength": 1,
          "title": "Seller Name",
          "type": "string"
        },
        "total_amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Total Amount",
          "type": "integer"
        }
      },
      "required": [
        "invoice_number",
        "invoice_date",
        "seller_name",
        "total_amount",
        "currency"
      ],
      "title": "FinalInvoiceData",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "enum": [
            "synthetic",
            "sample"
          ],
          "title": "Data Origin",
          "type": "string"
        },
        "prediction_source": {
          "enum": [
            "fixture",
            "model",
            "unavailable"
          ],
          "title": "Prediction Source",
          "type": "string"
        }
      },
      "required": [
        "data_origin",
        "prediction_source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinalInvoiceData"
        },
        {
          "$ref": "#/$defs/FinalApplicationData"
        }
      ],
      "title": "Data"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "document_type": {
      "enum": [
        "hoa_don",
        "don_de_nghi"
      ],
      "title": "Document Type",
      "type": "string"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "review_status": {
      "const": "confirmed",
      "default": "confirmed",
      "title": "Review Status",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "document_id",
    "run_id",
    "revision",
    "data",
    "provenance",
    "exported_at"
  ],
  "title": "ProductExportArtifact",
  "type": "object"
}
