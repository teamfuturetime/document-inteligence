{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "password": {
      "format": "password",
      "maxLength": 128,
      "minLength": 12,
      "title": "Password",
      "type": "string",
      "writeOnly": true
    },
    "username": {
      "pattern": "^[a-z][a-z0-9_-]{2,31}$",
      "title": "Username",
      "type": "string"
    }
  },
  "required": [
    "username",
    "password"
  ],
  "title": "Credentials",
  "type": "object"
}
