# ===== Ứng dụng =====
APP_NAME=Document Intelligence Vietnamese
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=di_session
SESSION_COOKIE_SECURE=false

# Chỉ dùng khi chạy lệnh seed demo; tự chọn giá trị, không commit mật khẩu thật.
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_NAME=demo
DEMO_USER_PASSWORD=

# ===== CORS =====
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/documents

# ===== Lưu trữ file =====
STORAGE_BACKEND=local
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=40000000
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ===== AI Service =====
AI_SERVICE_URL=http://localhost:8001
OCR_ENGINE=tesseract
OCR_LANG=vie
OCR_FALLBACK_ENABLED=false
AI_SERVICE_TIMEOUT_SECONDS=120
CLASSIFICATION_REVIEW_THRESHOLD=70

# ===== Lưu giữ dữ liệu =====
DATA_RETENTION_DAYS=30

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json
