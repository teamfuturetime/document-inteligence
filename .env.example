# Product: cài Tesseract 5 và chạy scripts/fetch_ocr_models.py trước.
# Fixture chỉ hoạt động khi chủ ý đổi thành fixture; không fallback khi OCR lỗi.
DOCINTEL_PROVIDER_MODE=tesseract
DOCINTEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Giới hạn runtime dùng chung cho API và pipeline.
DOCINTEL_MAX_UPLOAD_BYTES=5242880
DOCINTEL_MAX_IMAGE_PIXELS=16000000
DOCINTEL_MAX_PAGES=1
DOCINTEL_PROVIDER_TIMEOUT_SECONDS=30
DOCINTEL_MAX_PENDING_RUNS=5
# Best-effort local logging only; no email/webhook provider. Configure INFO handler to observe.
DOCINTEL_NOTIFICATION_MODE=log
DOCINTEL_NOTIFICATION_TIMEOUT_SECONDS=0.05
# Tesseract được tìm trên PATH hoặc vị trí Windows chuẩn; có thể override bằng đường dẫn thật.
# DOCINTEL_TESSERACT_EXECUTABLE=C:/Program Files/Tesseract-OCR/tesseract.exe
# Thư mục mặc định: runtime/models/tessdata_fast; không commit model weights hoặc DB.
